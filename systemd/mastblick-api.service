[Unit]
Description=mastblick: API und Push für die Karte
After=network.target

[Service]
User=mastblick
Group=mastblick
ExecStart=/opt/mastblick/bin/mastblick-api
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mastblick

[Install]
WantedBy=multi-user.target
