[Unit]
Description=mastblick: FRITZ!Box per TR-064 abfragen und über die Mobilfunkzelle verorten
After=network-online.target
Wants=network-online.target

[Service]
User=mastblick
Group=mastblick
ExecStart=/opt/mastblick/bin/mastblick-abfrage --loop
Restart=always
RestartSec=10
# wg show braucht CAP_NET_ADMIN, ping je nach System CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mastblick

[Install]
WantedBy=multi-user.target
